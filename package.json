{
  "name": "hiservis-ai",
  "version": "1.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run --prefix apps/web dev",
    "build:web": "npm run --prefix apps/web build",
    "test:web": "npm run --prefix apps/web test",
    "typecheck:web": "npm run --prefix apps/web typecheck",
    "build:api": "dotnet build apps/api/HiServis.Api.slnx",
    "test:api": "dotnet test apps/api/HiServis.Api.slnx",
    "build": "npm run build:web && npm run build:api",
    "test": "npm run test:web && npm run test:api"
  }
}
